---
const instagram = "https://www.instagram.com/visotskiy.denis/";
const tiktok = "https://www.tiktok.com/@denis.proboxer";
const imageBase = import.meta.env.BASE_URL + "images/";
const formats = [
  {
    number: "01",
    kind: "ГОЛОВНЕ ПАРТНЕРСТВО",
    title: "Головний партнер наступного бою",
    image: `${imageBase}partner-main-fight.png`,
    imageAlt: "Денис у боксерському рингу перед поєдинком, формат головного партнерства",
    description: "Я інтегрую ваш бренд у погоджену кампанію до наступного бою, від підготовки до післябойового контенту.",
    details: ["Пріоритетна інтеграція в кампанію", "Логотип у погоджених матеріалах", "Спільний анонс і підсумок за доступними метриками"],
    featured: true,
  },
  {
    number: "02",
    kind: "ЕКІПІРУВАННЯ Й ВИХІД",
    title: "Бренд на екіпіруванні",
    image: `${imageBase}partner-apparel.png`,
    imageAlt: "Денис готує боксерський одяг із місцем для бренду партнера",
    description: "Ваш знак може з’явитися на погодженому тренувальному одязі чи халаті та в контенті з підготовки.",
    details: ["Розміщення на вибраній екіпіровці", "Фото й відео з підготовки", "Бойова форма залежить від правил організатора"],
  },
  {
    number: "03",
    kind: "ПАРТНЕР ПІДГОТОВКИ",
    title: "Партнер тренувального табору",
    image: `${imageBase}partner-training-camp.png`,
    imageAlt: "Денис відпрацьовує удари з тренером у боксерському залі",
    description: "Підтримайте мою підготовку продуктом, сервісом або внеском у конкретну потребу табору.",
    details: ["Зал, екіпірування, логістика чи відновлення", "Згадка в контексті реального використання", "Напрям і обсяг узгоджуються наперед"],
  },
  {
    number: "04",
    kind: "МЕДІА Й PR",
    title: "Інформаційний партнер",
    image: `${imageBase}partner-media.png`,
    imageAlt: "Денис дає інтерв’ю після тренування, формат медіапартнерства",
    description: "Я відкритий до інтерв’ю, матеріалів і спільних анонсів, які познайомлять вашу аудиторію з моїм шляхом.",
    details: ["Інтерв’ю, пресматеріал чи згадка", "Погодження фактів та використання фото", "Поширення у ваших каналах"],
  },
  {
    number: "05",
    kind: "ЦИФРОВИЙ КОНТЕНТ",
    title: "Контент-партнер",
    image: `${imageBase}partner-content.png`,
    imageAlt: "Знімальна команда створює контент із Денисом під час тренування",
    description: "Створимо спільні відео й дописи, щоб органічно познайомити аудиторію з вашим брендом.",
    details: ["TikTok, Reels, Stories або допис", "Позначка, промокод чи заклик до дії", "Формат і статистика узгоджуються окремо"],
  },
  {
    number: "06",
    kind: "АКТИВАЦІЯ БРЕНДУ",
    title: "Активація для аудиторії",
    image: `${imageBase}partner-activation.png`,
    imageAlt: "Денис спілкується з уболівальниками після відкритого тренування",
    description: "Разом запустимо промокод, розіграш чи спеціальну пропозицію навколо бою й цілі вашого бізнесу.",
    details: ["Ідея під вашу аудиторію", "Контент та участь Дениса узгоджуються окремо", "Можна зібрати власний пакет"],
  },
];
const support = [
  { number: "01", title: "Щомісячна підтримка", text: "Обери комфортну для себе суму. Твій внесок допоможе мені планувати підготовку до наступного бою." },
  { number: "02", title: "Мій тренувальний табір", text: "Підтримай зал, збори, відновлення та щоденну роботу, з якої складається мій результат у рингу." },
  { number: "03", title: "Мій кут команди", text: "Будь поруч на кожному етапі й отримуй мої новини та ексклюзивні кадри, щойно запущу підписку." },
];
const videos = [
  { id: "7693489046215019798", label: "МОЯ ДИСЦИПЛІНА", title: "Робота, якої не видно за гонгом" },
  { id: "7693097503830330646", label: "МІЙ ТРЕНУВАЛЬНИЙ ПРОЦЕС", title: "Тренування є частиною мого шляху" },
];
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0d12" />
    <meta name="description" content="Мій шлях у професійному боксі, відео з підготовки та партнерство на наступний бій. Денис Висоцький." />
    <title>Денис Висоцький | Професійний боксер</title>
    <link rel="preload" as="image" href={`${imageBase}denis-hero-v2.png`} fetchpriority="high" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#top" aria-label="Денис Висоцький, на початок">
        <span class="brand-mark">DV</span>
        <span class="brand-name">DENIS<br />VISOTSKIY</span>
      </a>
      <nav class="main-nav" aria-label="Головна навігація">
        <a href="#profile">Профіль</a>
        <a href="#partners">Партнерам</a>
        <a href="#videos">Відео</a>
        <a href="#support">Фанатам</a>
      </nav>
      <a class="header-cta" href={instagram} target="_blank" rel="noreferrer">
        Зв'язатися <span aria-hidden="true">↗</span>
      </a>
    </header>

    <main>
      <section class="hero" id="top" aria-labelledby="hero-title">
        <div class="hero-photo" style={`--hero-image:url('${imageBase}denis-hero-v2.png')`} role="img" aria-label="Покращене фото Дениса Висоцького з українським та іспанським прапорами"></div>
        <div class="hero-shade"></div>
        <div class="hero-content">
          <p class="eyebrow"><span></span> УКРАЇНСЬКИЙ ПРОФЕСІЙНИЙ БОКС</p>
          <h1 id="hero-title">Денис<br /><em>Висоцький</em></h1>
          <p class="hero-subtitle">Я працюю задовго до того, як звучить гонг.</p>
          <div class="hero-actions">
            <a class="button button-blue" href="#partners">Стати партнером <span aria-hidden="true">↗</span></a>
            <a class="button button-quiet" href="#profile">Дізнатися більше <span aria-hidden="true">↓</span></a>
          </div>
        </div>
        <div class="hero-caption"><span>01</span> ПРАЦЯ. ХАРАКТЕР. РИНГ.</div>
        <div class="hero-social">
          <a href={instagram} target="_blank" rel="noreferrer" aria-label="Instagram Дениса">IG</a>
          <a href={tiktok} target="_blank" rel="noreferrer" aria-label="TikTok Дениса">TT</a>
        </div>
      </section>

      <section class="profile section-wrap" id="profile">
        <div class="profile-heading reveal">
          <p class="eyebrow eyebrow-dark">МІЙ ШЛЯХ У БОКСІ</p>
          <h2>Мій раунд<br />починається <span>до гонга.</span></h2>
        </div>
        <div class="profile-copy reveal">
        <p class="profile-intro">Я, Денис Висоцький, професійний боксер з України. На цій сторінці зібрав свій шлях, свою роботу й можливості для тих, хто хоче пройти наступний етап разом зі мною.</p>
          <div class="fact-list">
            <div><span>МОЄ ІМ'Я</span><strong>Денис Висоцький</strong></div>
            <div><span>МІЙ СПОРТ</span><strong>Професійний бокс</strong></div>
            <div><span>МОЯ КРАЇНА</span><strong>Україна</strong></div>
          </div>
          <p class="fact-note">Додам перевірені результати, титули й дати боїв після підтвердження.</p>
        </div>
        <figure class="gear-photo reveal">
          <img src={`${imageBase}denis-training.png`} alt="Згенерований тренувальний портрет Дениса Висоцького на основі фото профілю" loading="lazy" />
          <div class="social-proof" aria-label="Мої показники в соціальних мережах">
            <div><strong>4 263</strong><span>ПІДПИСНИКИ INSTAGRAM</span></div>
            <div><strong>34,2 тис.</strong><span>ПІДПИСНИКИ TIKTOK</span></div>
            <div><strong>1,3 млн</strong><span>ЛАЙКІВ У TIKTOK</span></div>
            <div><strong>≈ 3 млн</strong><span>ПЕРЕГЛЯДІВ ЗА ЖОВТЕНЬ*</span></div>
            <div><strong>≈ 50 млн</strong><span>ПЕРЕГЛЯДІВ ЗА ВЕСЬ ЧАС*</span></div>
            <p>Instagram: 4 263 підписники станом на 24.10.2026; TikTok: дані профілю на 24.10.2026. *Орієнтовні перегляди ще узгоджуються з Денисом.</p>
          </div>
        </figure>
      </section>

      <section class="partners section-wrap" id="partners">
        <div class="section-heading reveal">
          <p class="eyebrow">ДЛЯ ПАРТНЕРІВ, ЯКІ ГРАЮТЬ НА РЕЗУЛЬТАТ</p>
          <h2>Підсилюю<br /><span>ваш бізнес.</span></h2>
          <p class="section-lead">Я йду до наступного рівня в боксі й шукаю сильні бренди, яким близька ця амбіція. Разом ми можемо перетворити мою підготовку та медійність на впізнаваність, довіру й нові продажі для вашого бізнесу.</p>
        </div>
        <div class="reach-panel reveal">
          <div class="reach-copy">
            <p class="eyebrow">МОЯ АМБІЦІЯ В РИНГУ. ВАША ЦІЛЬ У БІЗНЕСІ.</p>
            <h3>Ваша ціль.<br /><span>Моя медійність.</span></h3>
            <p>Спершу я слухаю вашу бізнес-ціль: впізнаваність, довіру, трафік чи продажі. Потім пропоную кампанію з контентом та інтеграціями в моїх каналах і каналах бренду. Так ми разом виходимо на нову аудиторію в Україні й Європі; фактичні охоплення залежать від формату й дистрибуції.</p>
            <div class="reach-channels"><span>Мої соцмережі</span><span>Канали бренду</span><span>Медіа бою*</span></div>
            <small>*За наявності та після погодження з організатором. Перегляди й охоплення не гарантуються.</small>
          </div>
          <div class="reach-deliverables">
            <p class="eyebrow">Я ПРАЦЮЮ ЗА ЦІЛЯМИ БРЕНДУ</p>
            <div><span>01</span><p><strong>Впізнаваність</strong><br />контент, інтеграції та нова аудиторія</p></div>
            <div><span>02</span><p><strong>Інтерес і переходи</strong><br />промокод, посилання або заклик до дії</p></div>
            <div><span>03</span><p><strong>Зрозумілий підсумок</strong><br />охоплення й взаємодії за доступною статистикою</p></div>
          </div>
        </div>
        <div class="partner-grid">
          {formats.map((format) => (
            <article class:list={["partner-card", { featured: format.featured }]}>
              <img class="partner-image" src={format.image} alt={format.imageAlt} loading="lazy" />
              <div class="card-topline"><span>{format.number}</span><span>{format.kind}</span></div>
              <h3>{format.title}</h3>
              <p>{format.description}</p>
              <ul>{format.details.map((detail) => <li>{detail}</li>)}</ul>
              <a href={instagram} target="_blank" rel="noreferrer" aria-label={`Обговорити зі мною формат: ${format.title}`}>Обговорити зі мною <span aria-hidden="true">↗</span></a>
            </article>
          ))}
        </div>
        <div class="partner-process reveal">
          <p class="eyebrow">ЯК МИ ПРАЦЮЄМО</p>
          <div><span>01</span><strong>Визначаємо вашу ціль</strong><small>впізнаваність, контент, підтримка чи продажі</small></div>
          <div><span>02</span><strong>Узгоджуємо інтеграції</strong><small>бюджет, строки, права та правила бою</small></div>
          <div><span>03</span><strong>Запускаємо й підсумовуємо</strong><small>публікую погоджене й ділюся доступними результатами</small></div>
        </div>
        <div class="partner-cta reveal">
          <div><p class="eyebrow">ШУКАЮ ПАРТНЕРА НА НАСТУПНИЙ БІЙ</p><h3>Сильні цілі.<br />Сильна команда.</h3><p>Напишіть мені в Instagram слово «ПАРТНЕРСТВО», назву компанії та ціль, яку хочете посилити. Я запропоную формат під ваш бізнес.</p></div>
          <a class="button button-blue" href={instagram} target="_blank" rel="noreferrer">Написати мені <span aria-hidden="true">↗</span></a>
        </div>
        <p class="partner-terms">Пакети, ціни, кількість публікацій і права на зображення узгоджуються окремо. Розміщення на бойовій формі, участь у трансляції та міжнародне медіаохоплення можливі лише за підтвердженням організатора й медіапартнерів.</p>
      </section>

      <section class="tiktok-section section-wrap" id="videos">
        <div class="tiktok-heading reveal">
          <div>
            <p class="eyebrow">З МОГО ПРОФІЛЮ</p>
            <h2>Мій шлях.<br /><span>Мої кадри.</span></h2>
          </div>
          <div class="tiktok-description">
            <p>Мої бої, тренування й моменти між раундами. Тут розміщені оригінальні відео з мого TikTok.</p>
            <a class="text-link" href={tiktok} target="_blank" rel="noreferrer">Дивитися мій TikTok <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <div class="video-grid">
          {videos.map((video) => (
            <article class="video-card">
              <div class="video-frame">
                <iframe
                  src={`https://www.tiktok.com/player/v1/${video.id}?controls=1&description=1&music_info=0&loop=0&autoplay=0`}
                  title={`${video.title}, офіційне відео Denis Visotskiy у TikTok`}
                  loading="lazy"
                  allow="fullscreen; encrypted-media; picture-in-picture; web-share"
                  allowfullscreen
                ></iframe>
              </div>
              <div class="video-caption"><span>{video.label}</span><h3>{video.title}</h3></div>
            </article>
          ))}
        </div>
        <p class="media-note">Усі відео вбудовані з мого TikTok-профілю. Ілюстративні фотографії створені за моїм фото-референсом і не є кадрами реальних партнерських інтеграцій.</p>
      </section>

      <section class="support" id="support">
        <div class="support-image" style={`--support-image:url('${imageBase}denis-corner-v2.png')`} role="img" aria-label="Денис сидить у куті боксерського рингу під час тренувального табору"></div>
        <div class="support-content">
          <p class="eyebrow">ДЛЯ ВБОЛІВАЛЬНИКІВ · ПІДТРИМКА ЩОМІСЯЦЯ</p>
          <h2>Ти частина<br /><span>мого кута.</span></h2>
          <p>Якщо тобі близький мій шлях, підтримай мене між боями. Щомісячна підписка допомагатиме оплачувати тренувальний табір, екіпірування та дорогу на поєдинок. Для підписників я готуватиму новини й кадри з-за лаштунків.</p>
          <div class="support-list">
            {support.map((item) => (
              <div class="support-row"><span>{item.number}</span><div><h3>{item.title}</h3><p>{item.text}</p></div></div>
            ))}
          </div>
          <div class="support-actions">
            <a class="button button-dark" href={instagram} target="_blank" rel="noreferrer">Повідомити про запуск підписки <span aria-hidden="true">↗</span></a>
            <a class="text-link" href={tiktok} target="_blank" rel="noreferrer">Написати мені в TikTok <span aria-hidden="true">↗</span></a>
          </div>
          <p class="payment-note">Платіжну сторінку ще підключаємо. Напиши в Instagram слово «ПІДТРИМКА», щоб отримати повідомлення про запуск.</p>
        </div>
      </section>

      <section class="contact section-wrap">
        <div class="contact-title reveal">
          <p class="eyebrow">Я ВІДКРИТИЙ ДО СПІВПРАЦІ</p>
          <h2>Зустрінемося<br />біля <span>рингу.</span></h2>
        </div>
        <div class="contact-links reveal">
          <p>Маєш ідею партнерства або хочеш стежити за моїм шляхом? Напиши мені напряму.</p>
          <a href={instagram} target="_blank" rel="noreferrer"><span>INSTAGRAM</span><strong>@visotskiy.denis</strong><span aria-hidden="true">↗</span></a>
          <a href={tiktok} target="_blank" rel="noreferrer"><span>TIKTOK</span><strong>@denis.proboxer</strong><span aria-hidden="true">↗</span></a>
        </div>
      </section>
    </main>

    <footer class="footer">
      <a class="brand" href="#top"><span class="brand-mark">DV</span><span class="brand-name">DENIS<br />VISOTSKIY</span></a>
      <p>Український професійний бокс</p>
      <span>© {new Date().getFullYear()} Denis Visotskiy</span>
    </footer>
  </body>
</html>

<style is:global>
  :root{color-scheme:dark;--ink:#0a0d12;--panel:#101720;--panel2:#141d27;--paper:#f1f2ef;--muted:#a3adb7;--line:rgba(238,243,249,.15);--blue:#5577ff;--blue2:#7791ff;--display:Impact,"Arial Narrow",sans-serif;--body:Arial,Helvetica,sans-serif;--ease:cubic-bezier(.23,1,.32,1)}
